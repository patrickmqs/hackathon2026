{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend em Node + TypeScript + Express",
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/backend/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "AI_TESTS=1 vitest run tests/ai"
  },
  "dependencies": {
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
