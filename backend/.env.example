# Proposal AI — backend (exemplo sem segredos). Copie para `.env` e preencha.
# Valores documentados em docs/INTEGRATIONS.md §4.

# Ambiente
APP_ENV="development"
PORT="8000"

# Banco (PostgreSQL — Neon). Aponte para a sua URL postgresql://...
# e rode `npx prisma migrate deploy` para aplicar as migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Armazenamento de arquivos (áudio e PDFs)
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="25"
JOB_STALE_MINUTES="15"

# CORS e URLs
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:8000"

# Modo demo (habilita header X-Demo-User e flags *_FORCE_FAIL)
DEMO_MODE="true"

# OpenAI (obrigatório para o pipeline real; o stub determinístico dispensa)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe"
OPENAI_TIMEOUT_S="120"

# Gmail (OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GMAIL_FORCE_FAIL="false"

# WhatsApp (Baileys / WhatsApp Web — conta comum)
# Onde persistir a sessão (creds + keys); padrão = {STORAGE_DIR}/whatsapp
WHATSAPP_SESSION_DIR="./storage/whatsapp"
# true = pairing code em vez de QR (senão QR). A sessão é reutilizada entre reinícios.
WHATSAPP_PAIRING_CODE_MODE="false"
WHATSAPP_FORCE_FAIL="false"
